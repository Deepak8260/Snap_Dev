#############################################
# AWS & Infrastructure Configuration
#############################################
aws_region          = "us-east-1"
project_name        = "SnapDev"
environment         = "dev"
instance_type       = "t3.medium"
master_instance_name = "snapdev-jenkins-master"
agent_instance_name  = "snapdev-jenkins-agent"

#############################################
# Network & Security Configuration
#############################################
key_name        = "snapdev-key"
public_key_path = "~/.ssh/id_rsa.pub"
my_ip           = "0.0.0.0/0" # Change to YOUR_PUBLIC_IP/32 for enhanced security

#############################################
# Jenkins Admin & Credentials
#############################################
jenkins_admin_username = "admin"
jenkins_admin_password = "YourAdminPassword123!"

github_username    = "YOUR_GITHUB_USERNAME"
github_token       = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

dockerhub_username = "YOUR_DOCKERHUB_USERNAME"
dockerhub_password = "dckr_pat_xxxxxxxxxxxxxxxxxxxx"

#############################################
# Jenkins Agent Node Configuration
#############################################
agent_name      = "flask-app-agent"
agent_labels    = "flask-app-agent"
agent_remote_fs = "/home/ubuntu/jenkins"
agent_executors = 1

#############################################
# SMTP & Email Notification Configuration
#############################################
smtp_server   = "smtp.gmail.com"
smtp_port     = "465"
smtp_ssl      = true
smtp_username = "your-email@gmail.com"
smtp_password = "your-16-digit-app-password"
admin_email   = "your-email@gmail.com"